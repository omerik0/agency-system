# Variable names only. Never commit real values.
# Two kinds of .env file: the root .env (agency/business secrets) and
# sites/<client>/.env (that client's keys only). Both are gitignored.

# ===== Root .env (agency/business secrets) =====

# Root .env: URL of the business DB's Supabase project
SUPABASE_URL=
# Root .env: Postgres password of the business DB project
SUPABASE_DB_PASSWORD=
# Root .env: business DB service-role key (sb_secret_ format), server side only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=
# Root .env: Supabase organization ID that client projects are created under
SUPABASE_ORG_ID=
# Root .env: Supabase personal access token (org level), used to create/delete Supabase projects
SUPABASE_ACCESS_TOKEN=
# Root .env: Vercel token used by the deployment agent
VERCEL_TOKEN=

# ===== sites/<client>/.env (per-client keys) =====
# Supabase lines: only if the client has its own DB.
# Stripe lines: only if the site has billing.

# Per-client .env: URL of the client's own Supabase project
# SUPABASE_URL=
# Per-client .env: Postgres password generated when the client's project was created
# SUPABASE_DB_PASSWORD=
# Per-client .env: client DB service-role key (sb_secret_ format), server side only
# SUPABASE_SERVICE_ROLE_KEY=
# Per-client .env: secret key of the client's own Stripe account (test mode: sk_test_...)
# STRIPE_SECRET_KEY=
# Per-client .env: publishable key of the client's Stripe account (optional; the static Payment Link flow doesn't use it)
# STRIPE_PUBLISHABLE_KEY=
